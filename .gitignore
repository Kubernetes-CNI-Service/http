# Sanitised canonical bootstrap inputs.  These exact files are safe public
# source material; all real DAY0 project directories, generated output and
# runtime publication links above remain ignored.
!/DAY0-Prepare/template/
!/DAY0-Prepare/template/01-global.yaml
!/DAY0-Prepare/template/02-devices_config.csv
!/DAY0-Prepare/template/02-dhcp-subnet_config.csv
