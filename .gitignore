# Public-repository boundary
#
# This working tree is also an HTTP deployment root.  Keep field inputs,
# rendered configuration, runtime state and redistribution payloads local.
# Sanitised examples belong under examples/ and must be reviewed before they
# are staged.

# Workstation, editor and assistant state
.DS_Store
._*
Thumbs.db
*~
*.swp
*.swo
/.codex/
/.codex_tmp*/
/.agents/
**/.claude/
.idea/
.vscode/

# Language caches, local environments and downloaded dependencies
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.venv/
venv/
node_modules/

# Local credentials and host-specific environment
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.pub
id_rsa*
id_ed25519*
id_ecdsa*
**/.ssh/

# Logs, locks, transient output and rebuildable runtime selections
*.log
*.lock
*.pid
*.tmp
*.temp
*.bak
*.orig
*.rej
*.info
*.trace
core
core.*
**/collected/
**/logs/
**/*-logs
**/dumps/
**/old/
**/latest
**/latest-*
**/latest_*
**/99-output*

# These three historical .log files are versioned production rule sources,
# not runtime logs.  The NVOS paths are intentional canonical-source links.
!ztp/config/cumulus/template/P2P/01-inventory.log
!ztp/config/cumulus/template/P2P/02-port-mapping.log
!ztp/config/cumulus/template/P2P/03-splitter.log
!ztp/config/nvos/template/P2P/01-inventory.log
!ztp/config/nvos/template/P2P/02-port-mapping.log
!ztp/config/nvos/template/P2P/03-splitter.log

# Archives, packages, firmware, images and field-authored binary documents
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.zip
*.7z
*.rar
*.deb
*.rpm
*.cab
*.vme
*.bin
*.img
*.iso
*.qcow
*.qcow2
*.vmdk
*.xlsx
*.xls
*.xlsm
*.doc
*.docx
*.ppt
*.pptx
*.pdf
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.class
*.jar
*.war

# Offline mirrors, transfer products and review/render artefacts
/apps/*/
/download/
/package-imports/
/outputs/
/firmware/*
!/firmware/README.md
!/firmware/README.txt
/image/*
!/image/README.md
!/image/README.txt

# DAY0 project directories contain real inventories, topology, public keys,
# rendered configurations, backups and evidence.  Only the template's
# explanatory README files are public; sanitised examples live elsewhere.
/DAY0-Prepare/*/
!/DAY0-Prepare/template/
/DAY0-Prepare/template/**
!/DAY0-Prepare/template/README.txt
!/DAY0-Prepare/template/p2p/
!/DAY0-Prepare/template/p2p/README.txt

