FROM ubuntu:24.04

LABEL com.nvidia.http-ztp.image="true" \
      com.nvidia.http-ztp.image-flavor="generic" \
      com.nvidia.http-ztp.image-contract="3" \
      com.nvidia.http-ztp.base-os="ubuntu-24.04"

ARG DEBIAN_FRONTEND=noninteractive
ENV PATH=/opt/http-ztp/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONDONTWRITEBYTECODE=1

RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        apache2 \
        apache2-utils \
        ca-certificates \
        curl \
        git \
        graphviz \
        iproute2 \
        iputils-ping \
        isc-dhcp-server \
        jq \
        logrotate \
        openssh-client \
        procps \
        python3 \
        python3-dateutil \
        python3-et-xmlfile \
        python3-markupsafe \
        python3-numpy \
        python3-tz \
        python3-venv \
        rsync \
        rsyslog \
        sshpass \
        supervisor \
        tar \
        tzdata \
        unzip \
        util-linux \
        whois \
    && command -v ip >/dev/null \
    && command -v ss >/dev/null \
    && command -v ssh >/dev/null \
    && command -v mkpasswd >/dev/null \
    && command -v htpasswd >/dev/null \
    && test "$(getent group www-data | cut -d: -f3)" = 33 \
    && rm -rf /var/lib/apt/lists/* \
    && a2dissite 000-default \
    && a2enmod auth_basic authn_file authn_core authz_user authz_core env alias cgid headers \
    && a2enconf serve-cgi-bin \
    && printf '# Exact listeners are generated by /opt/http-ztp/activate.py.\n' \
        > /etc/apache2/ports.conf \
    && install -d -m 0700 /opt/http-ztp /run/http-ztp /var/lib/http-ztp \
    && install -d -o root -g root -m 0755 /usr/local/lib/http-ztp \
    && install -d -m 0750 /var/log/http-ztp /var/log/http-ztp/apache2 \
    && install -d -m 0755 /var/lib/dhcp /var/spool/rsyslog

COPY . /opt/http-ztp/source-tree/

RUN python3 -m venv --system-site-packages /opt/http-ztp/venv \
    && /opt/http-ztp/venv/bin/python -m pip install --no-deps --require-hashes -r /opt/http-ztp/source-tree/requirements-container-top-level.lock \
    && /opt/http-ztp/venv/bin/python /opt/http-ztp/source-tree/infra/docker/activate.py verify-python-runtime \
    && install -o root -g root -m 0755 \
        /opt/http-ztp/source-tree/infra/docker/activate.py \
        /opt/http-ztp/source-tree/infra/docker/entrypoint.py \
        /opt/http-ztp/source-tree/infra/docker/healthcheck.py \
        /opt/http-ztp/source-tree/infra/docker/hostctl.py \
        /opt/http-ztp/source-tree/infra/docker/hostlock.py \
        /opt/http-ztp/ \
    && install -o root -g root -m 0755 \
        /opt/http-ztp/source-tree/tools/control-auth.py \
        /opt/http-ztp/control-auth.py \
    && install -o root -g root -m 0755 \
        /opt/http-ztp/source-tree/tools/control-auth.py \
        /usr/local/lib/http-ztp/control-auth.py \
    && install -m 0644 \
        /opt/http-ztp/source-tree/infra/docker/rsyslog-dhcp.conf \
        /opt/http-ztp/source-tree/infra/docker/supervisord.conf \
        /opt/http-ztp/source-tree/infra/docker/apache-ztp.conf \
        /opt/http-ztp/source-tree/infra/docker/logrotate-http-ztp.conf \
        /opt/http-ztp/ \
    && chown root:root \
        /opt/http-ztp/source-tree \
        /opt/http-ztp/source-tree/tools \
        /opt/http-ztp/source-tree/tools/control-auth.py \
    && chmod 0755 \
        /opt/http-ztp/source-tree \
        /opt/http-ztp/source-tree/tools \
        /opt/http-ztp/source-tree/tools/control-auth.py \
        /opt/http-ztp/activate.py \
        /opt/http-ztp/entrypoint.py \
        /opt/http-ztp/healthcheck.py \
        /opt/http-ztp/hostctl.py \
        /opt/http-ztp/hostlock.py \
        /opt/http-ztp/control-auth.py \
    && cp /opt/http-ztp/supervisord.conf /etc/supervisor/supervisord.conf \
    && cp /opt/http-ztp/apache-ztp.conf \
        /etc/apache2/conf-enabled/http-ztp-public-boundary.conf \
    && install -m 0644 \
        /opt/http-ztp/source-tree/infra/docker/deployment-source-manifest.json \
        /opt/http-ztp/image-source.sha256 \
    && /opt/http-ztp/activate.py verify-source-manifest \
        --source-root /opt/http-ztp/source-tree \
        --manifest /opt/http-ztp/image-source.sha256 \
    && /opt/http-ztp/activate.py verify-control-auth-image \
        --manifest /opt/http-ztp/image-source.sha256 \
    && chmod 0644 \
        /opt/http-ztp/rsyslog-dhcp.conf \
        /opt/http-ztp/supervisord.conf \
        /opt/http-ztp/apache-ztp.conf \
        /opt/http-ztp/logrotate-http-ztp.conf \
        /opt/http-ztp/image-source.sha256 \
        /etc/supervisor/supervisord.conf \
        /etc/apache2/conf-enabled/http-ztp-public-boundary.conf

WORKDIR /var/www/html
USER root

HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=3 \
    CMD ["/opt/http-ztp/healthcheck.py"]

ENTRYPOINT ["/opt/http-ztp/entrypoint.py"]
CMD ["serve"]
