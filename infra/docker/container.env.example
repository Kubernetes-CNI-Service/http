# Copy to infra-runtime.conf on the Ubuntu management server.  That real file
# is host-specific and is excluded from git, sync-code, and upload archives.

# One directory name directly below /var/www/html/DAY0-Prepare.
HTTP_ZTP_PROJECT=replace-with-project-name

# One Docker deployment owns one generation and monitoring scope. AIR supports
# Cumulus only; prod defaults to all switch families unless narrowed below.
HTTP_ZTP_SCOPE=air
HTTP_ZTP_SWITCH_SCOPE=eth

# enabled passes the project's canonical 04-air-mini-devices.txt to 11-load.
# It is valid only with HTTP_ZTP_SCOPE=air and HTTP_ZTP_SWITCH_SCOPE=eth.
HTTP_ZTP_MINI=disabled
HTTP_ZTP_MONITOR_INTERVAL=30

# Optional safety ceiling.  Leave empty to derive every listener from the
# project DHCP rows and current host addresses.  Accepts zero, one, or any
# number of comma/space-separated logical interface names, including VLANs.
HTTP_ZTP_DHCP_INTERFACE_ALLOWLIST=

# Required only for a relay-only deployment whose DHCP ingress cannot be
# derived from an on-link ztp_service_ip.  This is also zero-to-N.
HTTP_ZTP_DHCP_RELAY_INGRESS=

# Fixed executable scratch directory for the short-lived SSH_ASKPASS helper.
# Keep this value unchanged: the container mounts /tmp with noexec.
HTTP_ZTP_ASKPASS_TMPDIR=/run/http-ztp/askpass

TZ=Asia/Shanghai
