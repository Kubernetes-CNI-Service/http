- set:
    bridge:
      domain:
        br_default:
          stp:
            priority: {{ g.bridge.domain.br_default.stp.priority }}
          vlan:
{% include '_bridge_l2vlans.yaml.j2' %}
{% include '_global_evpn.yaml.j2' %}
    interface:
      eth0:
        ipv4:
          address:
            {{ d.eth0_ip }}: {}
          gateway:
            {{ d.eth0_gw }}: {}
        type: eth
        vrf: mgmt
{% if d.has_eth1 %}
      eth1:
        ipv4:
          address:
            {{ d.eth1_ip }}: {}
          gateway:
            {{ d.eth1_gw }}: {}
        type: eth
{% endif %}
{% for bond in d.computed_bonds %}
      {{ bond.name }}:
        bond:
          lacp-bypass: enabled
          member:
{% if bond.type == 'localbond' %}
{% for m in bond.members %}
            {{ m }}: {}
{% endfor %}
{% else %}
            {{ bond.member }}: {}
{% endif %}
{% if bond.type == 'mlag' %}
          mlag:
            id: {{ bond.id }}
            state: enabled
{% endif %}
          mode: lacp
        bridge:
          domain:
            br_default:
{% if (bond.vlan_native | default(none)) is not none %}
              untagged: {{ bond.vlan_native }}
              vlan:
                '{{ bond.vlan_trunk_range }}': {}
{% elif bond.vlan_mode == 'access' %}
              access: {{ bond.vlan_access }}
{% else %}
              vlan:
                '{{ bond.vlan_trunk_range }}': {}
{% endif %}
        type: bond
{% if bond.type == 'evpn_multihoming' %}
        evpn:
          multihoming:
            segment:
              local-id: {{ bond.id }}
              mac-address: {{ bond.mac_address }}
              state: enabled
{% endif %}
{% if bond.type == 'localbond' %}
{% for m in bond.members %}
      {{ m }}:
        type: swp
{% endfor %}
{% endif %}
{% endfor %}
      lo:
        ipv4:
          address:
            {{ d.lo_ip }}: {}
        type: loopback
{% include '_direct_vlan_ports.yaml.j2' %}
{% if d.peerlink_member_list %}
      peerlink:
        bond:
          member:
{% for swp in d.peerlink_member_list %}
            {{ swp }}: {}
{% endfor %}
        type: peerlink
      peerlink.4094:
        base-interface: peerlink
        type: sub
        vlan: 4094
{% endif %}
{% for swp in d.bgp_plain_uplinks %}
      {{ swp }}:
        link:
          fec: auto
          mtu: 9216
        type: swp
{% endfor %}
{% for swp in d.member_swps %}
      {{ swp }}:
        link:
          fec: auto
          mtu: 9216
        type: swp
{% endfor %}
{% if d.peerlink_member_list %}
{% for swp in d.peerlink_member_list %}
      {{ swp }}:
        link:
          fec: auto
          mtu: 9216
        type: swp
{% endfor %}
{% endif %}
{% include '_l2_svis.yaml.j2' %}
{% if d.mlag_backup is defined %}
    mlag:
      backup:
        {{ d.mlag_backup }}: {}
      init-delay: {{ g.mlag['init-delay'] }}
      mac-address: {{ d.mlag_mac_address }}
      peer-ip: linklocal
      priority: {{ d.mlag_priority }}
      state: enabled
{% endif %}
    nve:
      vxlan:
        arp-nd-suppress: enabled
        decapsulation:
          dscp:
            action: preserve
        encapsulation:
          dscp:
            action: copy
{% if d.mlag_shared_address is defined %}
        mlag:
          shared-address: {{ d.mlag_shared_address }}
{% endif %}
        source:
          address: {{ d.lo_ip | replace('/32', '') }}
        state: enabled
    router:
      bfd:
        profile:
          bgp-underlay-bfd:
            detect-multiplier: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['detect-multiplier'] }}
            min-rx-interval: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['min-rx-interval'] }}
            min-tx-interval: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['min-tx-interval'] }}
        state: enabled
      bgp:
        graceful-restart:
          mode: full
          path-selection-deferral-time: 180
          restart-time: 180
          stale-routes-time: 180
        state: enabled
      policy:
        route-map:
          lo-to-bgp:
            rule:
              '10':
                action:
                  permit: {}
                match:
                  interface: lo
                  type: ipv4
      vrr:
        state: enabled
{% include '_dhcp_relay.yaml.j2' %}
    system:
      aaa:
        class:
          nvapply:
            action: allow
            command-path:
              /:
                permission: all
          nvshow:
            action: allow
            command-path:
              /:
                permission: ro
          sudo:
            action: allow
            command-path:
              /:
                permission: all
        role:
          nvue-admin:
            class:
              nvapply: {}
          nvue-monitor:
            class:
              nvshow: {}
          system-admin:
            class:
              nvapply: {}
              sudo: {}
        user:
          cumulus:
            full-name: '{{ g.system.aaa.user.cumulus["full-name"] }}'
            hashed-password: {{ g.system.aaa.user.cumulus['hashed-password'] }}
            role: system-admin
{% include '_extra_aaa_users.yaml.j2' %}
      api:
        state: enabled
      config:
        auto-save:
          state: enabled
      control-plane:
        acl:
          acl-default-dos:
            inbound: {}
          acl-default-whitelist:
            inbound: {}
      date-time:
        timezone: {{ g.system['date-time'].timezone }}
      dns:
        server:
{% for srv in g.system.dns.server %}
          {{ srv }}: {}
{% endfor %}
      docker:
        state: enabled
        vrf: mgmt
{% set schema_v2 = (d._project_schema_version|default(1)) == 2 %}
{% set emit_mlag_anycast = ((not schema_v2 and d.mlag_mac_address is defined) or (schema_v2 and d.mlag_vxlan_active_active|default(false))) %}
{% set emit_system_mac = (not schema_v2 and d.system_mac is defined and d.system_mac) %}
{% if emit_mlag_anycast or emit_system_mac %}
      global:
{% if emit_mlag_anycast %}
        anycast-mac: {{ d.mlag_mac_address }}
{% endif %}
{% if emit_system_mac %}
        system-mac: {{ d.system_mac }}
{% endif %}
{% endif %}
      hostname: {{ d.hostname }}
      ntp:
        server:
{% for srv in g.system.ntp.server %}
          {{ srv }}:
            iburst: enabled
{% endfor %}
      ssh-server:
        state: enabled
      wjh:
        channel:
          forwarding:
            trigger:
              l2: {}
              l3: {}
              tunnel: {}
        state: enabled
    vrf:
      default:
        router:
          bgp:
            address-family:
              ipv4-unicast:
                redistribute:
                  connected:
                    route-map: lo-to-bgp
                    state: enabled
                state: enabled
              l2vpn-evpn:
                state: enabled
            autonomous-system: {{ d.bgp_asn }}
            neighbor:
{% for nbr in d.bgp_neighbors %}
              {{ nbr }}:
                peer-group: underlay
                type: unnumbered
{% endfor %}
            path-selection:
              multipath:
                aspath-ignore: enabled
            peer-group:
              underlay:
                address-family:
                  l2vpn-evpn:
                    state: enabled
                bfd:
                  profile: bgp-underlay-bfd
                remote-as: external
            router-id: {{ d.lo_ip | replace('/32', '') }}
            state: enabled
{% for vrf in d.vrfs if vrf.evpn_vrf != 'default' %}
      {{ vrf.evpn_vrf }}:
        evpn:
          state: enabled
{% if vrf.evpn_l3vlan %}
          vlan: {{ vrf.evpn_l3vlan }}
{% endif %}
{% if vrf.evpn_l3vni is not none %}
          vni:
            '{{ vrf.evpn_l3vni }}': {}
{% endif %}
        router:
          bgp:
            address-family:
              ipv4-unicast:
                redistribute:
                  connected:
                    state: enabled
                  static:
                    state: enabled
                route-export:
                  to-evpn:
                    state: enabled
                state: enabled
            autonomous-system: {{ d.bgp_asn }}
            path-selection:
              multipath:
                aspath-ignore: enabled
            router-id: {{ d.lo_ip | replace('/32', '') }}
            state: enabled
{% if d.get('_project_schema_version', 1) == 2 and vrf.get('default_route_next_hop') %}
          static:
            default:
              address-family: ipv4-unicast
              via:
                {{ vrf.default_route_next_hop }}:
                  type: ipv4-address
{% elif d.get('_project_schema_version', 1) != 2 and vrf.l2vlans and vrf.l2vlans[0].vrr_ip %}
          static:
            default:
              address-family: ipv4-unicast
              via:
                {{ vrf.l2vlans[0].vrr_ip | vrr_gateway }}:
                  type: ipv4-address
{% endif %}
{% endfor %}
