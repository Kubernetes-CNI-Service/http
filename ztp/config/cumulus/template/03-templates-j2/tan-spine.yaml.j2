- set:
    bridge:
      domain:
        br_default:
          vlan: {}
    evpn:
      multihoming:
        state: enabled
      state: enabled
    interface:
      eth0:
        ipv4:
          address:
            {{ d.eth0_ip }}: {}
          gateway:
            {{ d.eth0_gw }}: {}
        type: eth
        vrf: mgmt
{% if d.has_eth1 %}
      eth1:
        ipv4:
          address:
            {{ d.eth1_ip }}: {}
          gateway:
            {{ d.eth1_gw }}: {}
        type: eth
{% endif %}
      lo:
        ipv4:
          address:
            {{ d.lo_ip }}: {}
        type: loopback
{% for swp_name, swp_info in d.bgp_uplink_parents.items() %}
      {{ swp_name }}:
        link:
          breakout:
            {{ swp_info.breakout }}x:
              lanes-per-port: '{{ swp_info.lanes }}'
        type: swp
{% for s in swp_info.subs %}
      {{ swp_name }}s{{ s }}:
{% if swp_info.evpn_uplink %}
        evpn:
          multihoming:
            uplink: enabled
{% endif %}
        type: swp
{% endfor %}
{% endfor %}
    nve:
      vxlan:
        arp-nd-suppress: enabled
        decapsulation:
          dscp:
            action: preserve
        encapsulation:
          dscp:
            action: copy
        source:
          address: {{ d.lo_ip | replace('/32', '') }}
        state: enabled
    router:
      bfd:
        profile:
          bgp-underlay-bfd:
            detect-multiplier: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['detect-multiplier'] }}
            min-rx-interval: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['min-rx-interval'] }}
            min-tx-interval: {{ g.vrf.default.router.bfd.profile['bgp-underlay-bfd']['min-tx-interval'] }}
        state: enabled
      bgp:
        graceful-restart:
          mode: full
          path-selection-deferral-time: 180
          restart-time: 180
          stale-routes-time: 180
        state: enabled
      policy:
        route-map:
          lo-to-bgp:
            rule:
              '10':
                action:
                  permit: {}
                match:
                  interface: lo
                  type: ipv4
      vrr:
        state: enabled
    service: {}
    system:
      aaa:
        class:
          nvapply:
            action: allow
            command-path:
              /:
                permission: all
          nvshow:
            action: allow
            command-path:
              /:
                permission: ro
          sudo:
            action: allow
            command-path:
              /:
                permission: all
        role:
          nvue-admin:
            class:
              nvapply: {}
          nvue-monitor:
            class:
              nvshow: {}
          system-admin:
            class:
              nvapply: {}
              sudo: {}
        user:
          cumulus:
            full-name: '{{ g.system.aaa.user.cumulus["full-name"] }}'
            hashed-password: {{ g.system.aaa.user.cumulus['hashed-password'] }}
            role: system-admin
{% include '_extra_aaa_users.yaml.j2' %}
      api:
        state: enabled
      config:
        auto-save:
          state: enabled
      control-plane:
        acl:
          acl-default-dos:
            inbound: {}
          acl-default-whitelist:
            inbound: {}
      date-time:
        timezone: {{ g.system['date-time'].timezone }}
      dns:
        server:
{% for srv in g.system.dns.server %}
          {{ srv }}: {}
{% endfor %}
      docker:
        state: enabled
        vrf: mgmt
      hostname: {{ d.hostname }}
      ntp:
        server:
{% for srv in g.system.ntp.server %}
          {{ srv }}:
            iburst: enabled
{% endfor %}
      ssh-server:
        state: enabled
      wjh:
        channel:
          forwarding:
            trigger:
              l2: {}
              l3: {}
              tunnel: {}
        state: enabled
    vrf:
      default:
        router:
          bgp:
            address-family:
              ipv4-unicast:
                redistribute:
                  connected:
                    route-map: lo-to-bgp
                    state: enabled
                state: enabled
              l2vpn-evpn:
                state: enabled
            neighbor:
{% for nbr in d.bgp_neighbors %}
              {{ nbr }}:
                peer-group: underlay
                type: unnumbered
{% endfor %}
            path-selection:
              multipath:
                aspath-ignore: enabled
            peer-group:
              underlay:
                address-family:
                  l2vpn-evpn:
                    state: enabled
                bfd:
                  profile: bgp-underlay-bfd
                remote-as: external
            autonomous-system: {{ d.bgp_asn }}
            router-id: {{ d.lo_ip | replace('/32', '') }}
            state: enabled
